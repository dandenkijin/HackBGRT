# UEFI Makefile for HackBGRT
# This Makefile builds the UEFI application on Linux using gnu-efi

# Target architecture (x86_64, i686)
ARCH ?= x86_64

# Toolchain - Use system gcc for gnu-efi
CC = gcc
LD = ld
OBJCOPY = objcopy

# Architecture settings
ifeq ($(ARCH),x86_64)
    EFI_ARCH = x86_64
    ARCH_CFLAGS = -m64 -mno-red-zone -mno-mmx -mno-sse -mno-sse2 -mno-3dnow
    ARCH_LDFLAGS = -melf_x86_64
else ifeq ($(ARCH),i686)
    EFI_ARCH = ia32
    ARCH_CFLAGS = -m32 -march=i686 -mno-red-zone -mno-mmx -mno-sse -mno-sse2 -mno-3dnow
    ARCH_LDFLAGS = -melf_i386
else
    $(error Unsupported architecture: $(ARCH))
endif

# System gnu-efi paths
EFI_INC = /usr/include/efi
EFI_ARCH_INC = /usr/include/efi/$(EFI_ARCH)
EFI_PROTOCOL_INC = /usr/include/efi/protocol
EFI_LIB = /usr/lib

# System C headers path
SYSROOT = $(shell gcc -print-sysroot)
C_INCLUDE = /usr/include

# Include paths
GNUEFI_INC = -I$(EFI_INC) \
              -I$(EFI_ARCH_INC) \
              -I$(EFI_PROTOCOL_INC) \
              -I/usr/include/efi/gnuefi \
              -isystem $(C_INCLUDE) \
              -isystem $(C_INCLUDE)/x86_64-linux-gnu

# Flags
CFLAGS = -Wall -Wextra -Werror \
         -Wno-sign-compare \
         -Wno-unused-parameter \
         -I. \
         -I$(EFI_INC) \
         -I$(EFI_ARCH_INC) \
         -I$(EFI_PROTOCOL_INC) \
         $(GNUEFI_INC) \
         -fno-stack-protector \
         -fno-stack-check \
         -fshort-wchar \
         -fno-strict-aliasing \
         -fno-merge-constants \
         -fno-builtin \
         -ffreestanding \
         -fpic \
         -fno-exceptions \
         -fno-asynchronous-unwind-tables \
         -mno-sse \
         -mno-mmx \
         -mno-sse2 \
         -mno-3dnow \
         -mno-red-zone \
         -maccumulate-outgoing-args \
         -DGNU_EFI_USE_MS_ABI \
         -D__KERNEL__ \
         -D__EFI__ \
         -D__$(shell echo $(EFI_ARCH) | tr '[:lower:]' '[:upper:]')__ \
         -isystem /usr/include \
         -nodefaultlibs \
         $(ARCH_CFLAGS)

# Our local source files
SRCS = $(wildcard src/*.c)
LOCAL_OBJS = $(SRCS:%.c=%.o)

# All objects need to be compiled with EFI flags
GNUEFI_OBJS = src/globals.o

# All objects to link
OBJS = $(LOCAL_OBJS) $(GNUEFI_OBJS) $(EFI_OBJS)

# Required EFI object files and libraries
EFI_CRT_OBJ = $(GNUEFI_PATH)/$(EFI_ARCH)/gnuefi/crt0-efi-x86_64.o

# Use local implementations instead of gnu-efi versions
EFI_LIBS = -Wl,--whole-archive \
           -lgnuefi -lefi \
           -Wl,--no-whole-archive

EFI_LDS = $(GNUEFI_PATH)/gnuefi/elf_x86_64_efi.lds

# EFI libraries to link against
# EFI_LIBS = -lefi -lgnuefi

# Linker flags
LDFLAGS = -nostdlib \
          -Wl,-dll \
          -Wl,--subsystem,10 \
          -Wl,--oformat,pei-x86-64 \
          -Wl,--disable-dynamicbase \
          -Wl,--strip-all \
          -e efi_main \
          -s \
          -L$(GNUEFI_PATH)/$(EFI_ARCH)/lib \
          -L$(GNUEFI_PATH)/$(EFI_ARCH)/gnuefi \
          -Wl,--entry=efi_main \
          -Wl,--defsym=efi_main=efi_main \
          -Wl,-Map=HackBGRT.map \
          -Wl,--gc-sections \
          -Wl,--whole-archive \
          $(EFI_LIBS) \
          -Wl,--no-whole-archive \
          -lgcc

# Source files
SRC = $(wildcard src/*.c)
OBJ = $(SRC:.c=.o)
TARGET = HackBGRT.efi hello.efi

# Default target
all: $(TARGET)

# Build the EFI application
HackBGRT.efi: $(OBJS) $(EFI_CRT_OBJ)
	$(CC) $(LDFLAGS) -o $@.tmp $(EFI_CRT_OBJ) $^
	$(OBJCOPY) -R .comment $@.tmp $@
	@rm -f $@.tmp

# Test application
HELLO_OBJS = hello.o hello_support.o src/util.o src/efi.o src/config.o src/globals.o src/efi_print.o src/efi_guids.o

hello.efi: $(HELLO_OBJS) $(EFI_CRT_OBJ)
	$(CC) $(LDFLAGS) -o $@.tmp $(EFI_CRT_OBJ) $^
	$(OBJCOPY) -R .comment $@.tmp $@
	@rm -f $@.tmp

hello.o: hello.c
	$(CC) $(CFLAGS) -I./src -I./gnu-efi/inc -I./gnu-efi/inc/x86_64 -I./gnu-efi/inc/protocol -c -o $@ $<

# Compile C files
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Clean build artifacts
clean:
	rm -f $(OBJ) $(TARGET) *.map

.PHONY: all clean

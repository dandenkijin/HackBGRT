# UEFI Makefile for HackBGRT
# This Makefile builds the UEFI application on Linux using MinGW-w64 cross-compiler

# Target architecture (x86_64, i686)
ARCH ?= x86_64

# Toolchain
ifeq ($(ARCH),x86_64)
    CC = x86_64-w64-mingw32-gcc
    LD = x86_64-w64-mingw32-ld
    OBJCOPY = x86_64-w64-mingw32-objcopy
    EFI_ARCH = x86_64
else ifeq ($(ARCH),i686)
    CC = i686-w64-mingw32-gcc
    LD = i686-w64-mingw32-ld
    OBJCOPY = i686-w64-mingw32-objcopy
    EFI_ARCH = ia32
else
    $(error Unsupported architecture: $(ARCH))
endif

# Paths - Use local gnu-efi submodule
GNUEFI_PATH = $(shell pwd)/gnu-efi
EFI_INC = $(GNUEFI_PATH)/inc
EFI_ARCH_INC = $(GNUEFI_PATH)/inc/$(EFI_ARCH)
EFI_PROTOCOL_INC = $(GNUEFI_PATH)/inc/protocol
EFI_LIB = $(GNUEFI_PATH)/$(EFI_ARCH)/lib

# No need for pkg-config with local gnu-efi
GNUEFI_INC = -I$(EFI_INC) -I$(EFI_ARCH_INC) -I$(EFI_PROTOCOL_INC) -I$(GNUEFI_PATH)/inc/gnuefi

# Flags
CFLAGS = -Wall -Wextra -Werror \
         -Wno-sign-compare \
         -Wno-unused-parameter \
         -I. \
         -I$(EFI_INC) \
         -I$(EFI_ARCH_INC) \
         -I$(EFI_PROTOCOL_INC) \
         $(GNUEFI_INC) \
         -ffreestanding \
         -fno-stack-protector \
         -fno-stack-check \
         -fshort-wchar \
         -mno-red-zone \
         -mno-avx \
         -maccumulate-outgoing-args \
         -DEFI_FUNCTION_WRAPPER \
         -DGNU_EFI_USE_MS_ABI \
         -D__MAKEWITH_GNUEFI

# Our local source files (exclude globals.c as it's included separately)
SRCS = $(filter-out src/globals.c,$(wildcard src/*.c))
LOCAL_OBJS = $(SRCS:%.c=%.o)

# Our globals.c needs to be compiled with EFI flags
GNUEFI_OBJS = src/globals.o

# All objects to link
OBJS = $(LOCAL_OBJS) $(GNUEFI_OBJS) $(EFI_OBJS)

# Required EFI object files and libraries
EFI_CRT_OBJ = $(GNUEFI_PATH)/$(EFI_ARCH)/gnuefi/crt0-efi-x86_64.o

# Use local implementations instead of gnu-efi versions
EFI_LIBS = -Wl,--whole-archive \
           -lgnuefi \
           -Wl,--no-whole-archive \
           -Wl,--exclude-libs=libefi.a \
           -Wl,--exclude-libs=libgnuefi.a

EFI_LDS = $(GNUEFI_PATH)/gnuefi/elf_x86_64_efi.lds

# EFI libraries to link against
# EFI_LIBS = -lefi -lgnuefi

# Linker flags
LDFLAGS = -nostdlib \
          -Wl,-dll \
          -Wl,--subsystem,10 \
          -Wl,--oformat,pei-x86-64 \
          -Wl,--disable-dynamicbase \
          -Wl,--strip-all \
          -e efi_main \
          -s \
          -L$(GNUEFI_PATH)/$(EFI_ARCH)/lib \
          -L$(GNUEFI_PATH)/$(EFI_ARCH)/gnuefi \
          -Wl,--entry=efi_main \
          -Wl,--defsym=efi_main=efi_main \
          -Wl,-Map=HackBGRT.map \
          -Wl,--gc-sections \
          -Wl,--whole-archive \
          $(EFI_LIBS) \
          -Wl,--no-whole-archive \
          -lgcc

# Source files
SRC = $(wildcard src/*.c)
OBJ = $(SRC:.c=.o)
TARGET = HackBGRT.efi hello.efi

# Default target
all: $(TARGET)

# Build the EFI application
HackBGRT.efi: $(OBJS)
	$(CC) -o $@.tmp $^ $(LDFLAGS)
	$(OBJCOPY) -R .comment $@.tmp $@
	@rm -f $@.tmp

# Test application
HELLO_OBJS = hello.o hello_support.o src/util.o src/efi.o src/config.o src/globals.o src/efi_print.o src/efi_guids.o

hello.efi: $(HELLO_OBJS)
	$(CC) -nostdlib -Wl,-dll -shared -Wl,--subsystem,10 -e efi_main -o $@.tmp $^ $(LIBS)
	$(OBJCOPY) -R .comment $@.tmp $@
	@rm -f $@.tmp

hello.o: hello.c
	$(CC) $(CFLAGS) -I./src -I./gnu-efi/inc -I./gnu-efi/inc/x86_64 -I./gnu-efi/inc/protocol -c -o $@ $<

# Compile C files
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Clean build artifacts
clean:
	rm -f $(OBJ) $(TARGET) *.map

.PHONY: all clean
